EDITOR="/usr/bin/vim"

CDPATH="${CDPATH}:.:..:../..:${HOME}:${HOME}/projects"

PATH="${HOME}/.local/bin:${PATH}"

PS1='\t `if [ $? = 0 ]; then echo "\[\033[01;32m\]✓"; else echo "\[\033[01;31m\]✗"; fi`\[\033[90;36m\]`parse_branch`\[\033[00m\]'
PS1="${PS1} [\[\033[01;30m\]@\h \[\033[01;34m\]\W\[\033[00m\]\[\033[01;00m\]]$\[\033[00m\] "

PROMPT_COMMAND=git_terminal_title 2> /dev/null

export CDPATH EDITOR PAGER PATH PS1 PROMPT_COMMAND

#history

HISTFILESIZE=10000
HISTSIZE=10000
HISTCONTROL=ignoredups:ignoreboth:ignorerespace
HISTIGNORE="ls:history"
HIST_BLUE="\033[0;34m"
HIST_NOCOLOR="\033[0m"
HISTTIMEFORMAT=`echo -e ${HIST_BLUE}[%F %T] ${HIST_NOCOLOR} `

shopt -s globstar
shopt -s histappend
shopt -s cmdhist
shopt -s checkwinsize

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
	if [ -f /usr/share/bash-completion/bash_completion ]; then
		. /usr/share/bash-completion/bash_completion
	elif [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi
fi

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

export HISTFILESIZE HISTSIZE HISTCONTROL HISTIGNORE HISTTIMEFORMAT



